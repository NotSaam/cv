---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ContactCard from '../components/ContactCard.astro';
import ContactForm from '../components/ContactForm.astro';
import { profile } from '../data/profile';
---
<BaseLayout title="Contacto — Samuel Fuentes" description="Contacta con Samuel Fuentes (NotSaam): rellena el formulario o escríbeme en GitHub, LinkedIn o Instagram.">
  <Section eyebrow="Contacto" title="Hablemos" lead="¿Construimos algo juntos? Rellena el formulario o usa cualquiera de estos canales." class="pt-36">
    <div class="reveal mb-12">
      <ContactForm />
    </div>
    <div class="grid gap-4 sm:grid-cols-3">
      <div class="reveal"><ContactCard icon="⌨︎" label="GitHub" handle="@NotSaam" href={profile.links.github} /></div>
      <div class="reveal"><ContactCard icon="in" label="LinkedIn" handle="/in/notsaam" href={profile.links.linkedin} /></div>
      <div class="reveal"><ContactCard icon="◎" label="Instagram" handle="@flk0s_" href={profile.links.instagram} /></div>
      {profile.links.email && (
        <div class="reveal"><ContactCard icon="✉" label="Email" handle={profile.links.email.replace('mailto:', '')} href={profile.links.email} /></div>
      )}
    </div>
  </Section>
</BaseLayout>
