---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import TimelineItem from '../components/TimelineItem.astro';
import { experience } from '../data/experience';
---
<BaseLayout title="Experiencia — Samuel Fuentes" description="Trayectoria autodidacta y práctica en desarrollo, IA y ciberseguridad.">
  <Section eyebrow="Trayectoria" title="Experiencia & Formación" lead="Una trayectoria autodidacta y práctica: aprender construyendo proyectos reales." class="pt-36">
    <div class="relative max-w-2xl pl-9">
      <span class="absolute left-[7px] top-2 bottom-2 w-0.5 bg-gradient-to-b from-accent-blue via-accent-violet to-accent-cyan"></span>
      {experience.map((m) => <div class="reveal"><TimelineItem item={m} /></div>)}
    </div>
    <p class="reveal mt-8 max-w-2xl text-sm italic text-ink-faint">
      Formación reflejada a partir de información pública y de la trayectoria de proyectos. Sin titulaciones ni certificaciones inventadas.
    </p>
  </Section>
</BaseLayout>
