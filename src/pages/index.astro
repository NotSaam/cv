---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TechCard from '../components/TechCard.astro';
import ContactCard from '../components/ContactCard.astro';
import ContactForm from '../components/ContactForm.astro';
import { withBase } from '../lib/url';
import { about, profile } from '../data/profile';
import { projects } from '../data/projects';
import { techStack } from '../data/tech';
---
<BaseLayout>
  <Hero />

  <Section id="sobre-mi" eyebrow="01 — Perfil" title="Sobre mí" lead="Desarrollador autodidacta con base en desarrollo web, hoy enfocado en IA, sistemas y ciberseguridad.">
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {about.map((a) => (
        <article class="card-surface reveal p-7">
          <h3 class="text-lg font-bold tracking-tight">{a.title}</h3>
          <p class="mt-2.5 text-[15px] text-ink-muted">{a.body}</p>
        </article>
      ))}
    </div>
    <div class="reveal mt-8">
      <a href={withBase('/sobre-mi')} class="text-sm text-accent-cyan hover:underline">Más sobre mí →</a>
    </div>
  </Section>

  <Section eyebrow="02 — Trabajo" title="Proyectos principales" lead="Dos ecosistemas construidos end-to-end.">
    <div class="grid gap-5 md:grid-cols-2">
      {projects.map((p) => <div class="reveal"><ProjectCard project={p} /></div>)}
    </div>
  </Section>

  <Section eyebrow="03 — Herramientas" title="Stack tecnológico" lead="Tecnologías con las que diseño, construyo y opero.">
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
      {techStack.map((t) => <div class="reveal"><TechCard tech={t} /></div>)}
    </div>
  </Section>

  <Section eyebrow="04 — Norte" title="Visión" center>
    <div class="reveal mx-auto max-w-3xl rounded-[1.75rem] border border-line/10 bg-[radial-gradient(120%_120%_at_50%_0%,rgba(91,140,255,0.08),transparent_60%)] px-6 py-16 text-center sm:px-10">
      <h3 class="mx-auto max-w-2xl text-2xl font-extrabold leading-tight tracking-tight sm:text-4xl">
        Construyendo herramientas centradas en <span class="grad-text">IA, automatización y sistemas modernos.</span>
      </h3>
      <p class="mx-auto mt-6 max-w-xl text-lg text-ink-muted">
        Cada proyecto es una pieza de un ecosistema mayor. El objetivo no es una demo: es construir software serio, coherente y con proyección a largo plazo.
      </p>
    </div>
  </Section>

  <Section id="contacto" eyebrow="05 — Contacto" title="Hablemos" lead="¿Construimos algo juntos? Rellena el formulario o escríbeme directamente.">
    <div class="reveal mb-12">
      <ContactForm />
    </div>
    <div class="grid gap-4 sm:grid-cols-3">
      <div class="reveal"><ContactCard icon="⌨︎" label="GitHub" handle="@NotSaam" href={profile.links.github} /></div>
      <div class="reveal"><ContactCard icon="in" label="LinkedIn" handle="/in/notsaam" href={profile.links.linkedin} /></div>
      <div class="reveal"><ContactCard icon="◎" label="Instagram" handle="@flk0s_" href={profile.links.instagram} /></div>
    </div>
  </Section>
</BaseLayout>
