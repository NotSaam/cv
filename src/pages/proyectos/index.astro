---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
---
<BaseLayout title="Proyectos — Samuel Fuentes" description="FLAKAI y FLK0S: dos ecosistemas construidos end-to-end en IA y ciberseguridad.">
  <Section eyebrow="Trabajo" title="Proyectos" lead="Dos ecosistemas construidos end-to-end. Pulsa para ver el detalle de cada uno." class="pt-36">
    <div class="grid gap-5 md:grid-cols-2">
      {projects.map((p) => <div class="reveal"><ProjectCard project={p} /></div>)}
    </div>
  </Section>
</BaseLayout>
