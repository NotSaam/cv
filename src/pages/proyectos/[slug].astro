---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const accent = project.accent === 'cyan' ? 'bg-accent-cyan' : 'bg-accent-violet';

const blocks = [
  { label: 'Descripción', value: project.description },
  { label: 'Objetivo', value: project.objective },
  { label: 'Arquitectura', value: project.architecture },
  { label: 'Estado actual', value: project.state },
  { label: 'Visión', value: project.vision },
].filter((b) => b.value);
---
<BaseLayout title={`${project.name} — Samuel Fuentes`} description={project.summary}>
  <article class="container-content pt-36">
    <a href={withBase('/proyectos')} class="text-sm text-ink-muted transition hover:text-ink">← Proyectos</a>

    <header class="reveal mt-6">
      <span class:list={['mb-5 block h-1.5 w-14 rounded-full', accent]}></span>
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">{project.name}</h1>
      <p class="mt-2 text-ink-muted">{project.tagline}</p>
      <a href={project.link} target="_blank" rel="noopener" class="btn btn-primary mt-6">Ver proyecto</a>
    </header>

    <div class="mt-12 grid gap-x-10 gap-y-8 sm:grid-cols-2">
      {blocks.map((b) => (
        <div class="reveal">
          <h2 class="mb-2 font-mono text-xs uppercase tracking-[0.08em] text-accent-cyan">{b.label}</h2>
          <p class="text-[15px] leading-relaxed text-ink-muted">{b.value}</p>
        </div>
      ))}
    </div>

    <div class="reveal mt-12">
      <h2 class="mb-3 font-mono text-xs uppercase tracking-[0.08em] text-accent-cyan">Tecnologías</h2>
      <div class="flex flex-wrap gap-2">
        {project.tech.map((t) => <span class="chip">{t}</span>)}
      </div>
    </div>
  </article>
</BaseLayout>
