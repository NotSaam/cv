---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import TechCard from '../components/TechCard.astro';
import { techStack } from '../data/tech';
---
<BaseLayout title="Tecnologías — Samuel Fuentes" description="Stack tecnológico: Python, JavaScript, FastAPI, Linux, Docker, IA y ciberseguridad.">
  <Section eyebrow="Herramientas" title="Tecnologías" lead="Tecnologías con las que diseño, construyo y opero." class="pt-36">
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
      {techStack.map((t) => <div class="reveal"><TechCard tech={t} /></div>)}
    </div>
  </Section>
</BaseLayout>
