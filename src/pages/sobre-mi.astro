---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import { about, profile } from '../data/profile';
---
<BaseLayout title={`Sobre mí — ${profile.name}`} description={profile.intro}>
  <Section eyebrow="Perfil" title="Sobre mí" lead="Desarrollador autodidacta con base en desarrollo web, hoy enfocado en inteligencia artificial, sistemas y ciberseguridad." class="pt-36">
    <div class="grid gap-4 md:grid-cols-2">
      {about.map((a) => (
        <article class="card-surface reveal p-8">
          <h3 class="text-xl font-bold tracking-tight">{a.title}</h3>
          <p class="mt-3 text-ink-muted">{a.body}</p>
        </article>
      ))}
    </div>
  </Section>
</BaseLayout>
