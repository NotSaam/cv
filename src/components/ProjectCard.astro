---
import { withBase } from '../lib/url';
import type { Project } from '../data/projects';
export interface Props { project: Project }
const { project } = Astro.props;
const accent = project.accent === 'cyan' ? 'bg-accent-cyan' : 'bg-accent-violet';
---
<a
  href={withBase(`/proyectos/${project.slug}`)}
  class="card-surface group block p-7 sm:p-8"
>
  <span class:list={['mb-5 block h-1.5 w-12 rounded-full', accent]}></span>
  <div class="flex items-baseline justify-between gap-4">
    <h3 class="text-2xl font-extrabold tracking-tight">{project.name}</h3>
    <span class="text-ink-faint transition group-hover:translate-x-1 group-hover:text-ink">→</span>
  </div>
  <p class="mt-1 text-sm text-ink-muted">{project.tagline}</p>
  <p class="mt-4 text-[15px] text-ink-muted">{project.summary}</p>
  <div class="mt-5 flex flex-wrap gap-2">
    {project.tech.slice(0, 4).map((t) => <span class="chip">{t}</span>)}
  </div>
</a>
