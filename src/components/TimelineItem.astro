---
import type { Milestone } from '../data/experience';
export interface Props { item: Milestone }
const { item } = Astro.props;
---
<div class="relative mb-6">
  <span class="absolute -left-[34px] top-5 grid h-4 w-4 place-items-center rounded-full border-2 border-accent-cyan bg-bg shadow-[0_0_14px_rgba(34,211,238,0.6)]"></span>
  <div class="card-surface p-6">
    <span class="mb-2 inline-block font-mono text-[11px] uppercase tracking-[0.1em] text-accent-violet">{item.tag}</span>
    <h3 class="text-lg font-bold">{item.title}</h3>
    <p class="mt-1.5 text-[15px] text-ink-muted">{item.body}</p>
  </div>
</div>
