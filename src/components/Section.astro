---
export interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  lead?: string;
  center?: boolean;
  class?: string;
}
const { id, eyebrow, title, lead, center = false, class: cls = '' } = Astro.props;
---
<section id={id} class:list={['container-content pt-28 scroll-mt-24', cls]}>
  {(eyebrow || title || lead) && (
    <div class:list={['reveal mb-12 max-w-2xl', center && 'mx-auto text-center']}>
      {eyebrow && <span class="eyebrow mb-4">{eyebrow}</span>}
      {title && (
        <h2 class="text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl md:text-5xl">
          {title}
        </h2>
      )}
      {lead && <p class="mt-4 text-lg text-ink-muted">{lead}</p>}
    </div>
  )}
  <slot />
</section>
