---
export interface Props {
  icon: string;
  label: string;
  handle: string;
  href: string;
}
const { icon, label, handle, href } = Astro.props;
---
<a href={href} target="_blank" rel="noopener" class="card-surface block p-8 text-center">
  <span class="mx-auto mb-4 grid h-13 w-13 place-items-center rounded-2xl border border-line/10 bg-surface/[0.06] text-xl font-bold" style="height:3.25rem;width:3.25rem">{icon}</span>
  <h4 class="text-[17px] font-bold">{label}</h4>
  <p class="mt-1 font-mono text-sm text-ink-muted">{handle}</p>
</a>
