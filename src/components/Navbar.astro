---
import { withBase } from '../lib/url';
import { profile } from '../data/profile';
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { label: 'Sobre mí', href: withBase('/sobre-mi') },
  { label: 'Proyectos', href: withBase('/proyectos') },
  { label: 'Experiencia', href: withBase('/experiencia') },
  { label: 'Tecnologías', href: withBase('/tecnologias') },
  { label: 'Contacto', href: withBase('/contacto') },
];
const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => path === href.replace(/\/$/, '');
---

<header
  id="nav"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition duration-300 ease-smooth"
>
  <div class="container-content flex items-center justify-between py-4">
    <a href={withBase('/')} class="flex items-center gap-2.5 font-bold tracking-tight">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-grad text-[13px] font-extrabold text-bg">SF</span>
      <span class="hidden text-[15px] sm:block">{profile.name}</span>
    </a>

    <nav class="hidden items-center gap-7 md:flex">
      {nav.map((i) => (
        <a
          href={i.href}
          class:list={[
            'text-sm transition hover:text-ink',
            isActive(i.href) ? 'text-ink' : 'text-ink-muted',
          ]}
        >
          {i.label}
        </a>
      ))}
      <ThemeToggle />
    </nav>

    <div class="flex items-center gap-2 md:hidden">
      <ThemeToggle />
      <button id="navToggle" aria-label="Menú" class="flex flex-col gap-1.5 p-1.5">
        <span class="h-0.5 w-5 rounded bg-ink transition"></span>
        <span class="h-0.5 w-5 rounded bg-ink transition"></span>
        <span class="h-0.5 w-5 rounded bg-ink transition"></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <nav
    id="mobileMenu"
    class="container-content hidden flex-col gap-1 pb-4 md:!hidden"
  >
    {nav.map((i) => (
      <a href={i.href} class="rounded-xl px-4 py-3 text-ink-muted transition hover:bg-surface/[0.06] hover:text-ink">
        {i.label}
      </a>
    ))}
  </nav>
</header>

<script is:inline>
  const navEl = document.getElementById('nav');
  const onScroll = () => {
    const s = window.scrollY > 24;
    navEl.classList.toggle('border-line/10', s);
    navEl.style.background = s ? 'rgb(var(--bg) / 0.72)' : 'transparent';
    navEl.style.backdropFilter = s ? 'blur(16px) saturate(160%)' : 'none';
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const toggle = document.getElementById('navToggle');
  const menu = document.getElementById('mobileMenu');
  toggle?.addEventListener('click', () => {
    menu.classList.toggle('hidden');
    menu.classList.toggle('flex');
  });
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      menu.classList.remove('flex');
    })
  );
</script>
