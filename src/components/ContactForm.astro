---
import { profile } from '../data/profile';
// La access key de Web3Forms se guarda en profile.ts (contactFormKey).
// Obténla gratis en https://web3forms.com poniendo tu correo: te llega por email.
const key = profile.contactFormKey;
---
{key ? (
  <form id="contactForm" class="card-surface mx-auto max-w-xl p-6 sm:p-8 text-left">
    <input type="hidden" name="access_key" value={key} />
    <input type="hidden" name="subject" value="Nuevo mensaje desde el portfolio" />
    <input type="hidden" name="from_name" value="Portfolio — notsaam.github.io" />
    <!-- Honeypot anti-spam -->
    <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

    <div class="grid gap-4 sm:grid-cols-2">
      <label class="block">
        <span class="mb-1.5 block text-sm font-medium text-ink-muted">Nombre</span>
        <input
          type="text" name="name" required autocomplete="name"
          class="w-full rounded-xl border border-line/10 bg-surface/[0.04] px-4 py-3 text-ink outline-none transition placeholder:text-ink-faint focus:border-accent-cyan/60 focus:bg-surface/[0.07]"
          placeholder="Tu nombre"
        />
      </label>
      <label class="block">
        <span class="mb-1.5 block text-sm font-medium text-ink-muted">Email</span>
        <input
          type="email" name="email" required autocomplete="email"
          class="w-full rounded-xl border border-line/10 bg-surface/[0.04] px-4 py-3 text-ink outline-none transition placeholder:text-ink-faint focus:border-accent-cyan/60 focus:bg-surface/[0.07]"
          placeholder="tucorreo@ejemplo.com"
        />
      </label>
    </div>
    <label class="mt-4 block">
      <span class="mb-1.5 block text-sm font-medium text-ink-muted">Mensaje</span>
      <textarea
        name="message" required rows="5"
        class="w-full resize-y rounded-xl border border-line/10 bg-surface/[0.04] px-4 py-3 text-ink outline-none transition placeholder:text-ink-faint focus:border-accent-cyan/60 focus:bg-surface/[0.07]"
        placeholder="Cuéntame en qué puedo ayudarte…"
      ></textarea>
    </label>

    <button type="submit" id="contactSubmit" class="btn btn-primary mt-5 w-full justify-center sm:w-auto">
      <span class="label">Enviar mensaje</span>
      <span class="spinner hidden">Enviando…</span>
    </button>

    <p id="contactStatus" class="mt-4 hidden text-sm" role="status" aria-live="polite"></p>
  </form>

  <script is:inline>
    (() => {
      const form = document.getElementById('contactForm');
      if (!form) return;
      const btn = document.getElementById('contactSubmit');
      const status = document.getElementById('contactStatus');
      const label = btn.querySelector('.label');
      const spinner = btn.querySelector('.spinner');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        status.className = 'mt-4 hidden text-sm';
        btn.disabled = true; label.classList.add('hidden'); spinner.classList.remove('hidden');

        try {
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(Object.fromEntries(new FormData(form))),
          });
          const data = await res.json();
          if (data.success) {
            form.reset();
            status.textContent = '✓ ¡Mensaje enviado! Te responderé pronto.';
            status.className = 'mt-4 text-sm text-accent-cyan';
          } else {
            throw new Error(data.message || 'Error');
          }
        } catch (err) {
          status.textContent = '✗ No se pudo enviar. Inténtalo de nuevo o escríbeme por email.';
          status.className = 'mt-4 text-sm text-red-400';
        } finally {
          btn.disabled = false; label.classList.remove('hidden'); spinner.classList.add('hidden');
        }
      });
    })();
  </script>
) : (
  <div class="card-surface mx-auto max-w-xl p-6 text-center text-sm text-ink-muted">
    Formulario en configuración. Mientras tanto, escríbeme a
    <a href={profile.links.email} class="text-accent-cyan hover:underline"> {profile.links.email.replace('mailto:', '')}</a>.
  </div>
)}
