---
import type { Tech } from '../data/tech';
export interface Props { tech: Tech }
const { tech } = Astro.props;
---
<div class="card-surface p-6 text-center">
  <span class="mb-3 block text-3xl">{tech.icon}</span>
  <h4 class="text-[15px] font-semibold">{tech.name}</h4>
  <p class="mt-1 text-xs text-ink-faint">{tech.note}</p>
</div>
