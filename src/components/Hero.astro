---
import { withBase } from '../lib/url';
import { profile } from '../data/profile';
---
<section class="container-content grid min-h-[92vh] items-center gap-14 pt-40 pb-10 lg:grid-cols-[1.15fr_0.85fr]">
  <div class="animate-fade-up">
    <span class="mb-7 inline-flex items-center gap-2.5 rounded-full border border-line/10 bg-surface/[0.03] px-4 py-1.5 text-[13px] text-ink-muted">
      <span class="h-1.5 w-1.5 rounded-full bg-accent-cyan shadow-[0_0_10px_#22d3ee] animate-pulse"></span>
      Disponible para construir
    </span>
    <h1 class="text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-5xl md:text-6xl">
      Construyendo herramientas centradas en
      <span class="grad-text">IA, automatización y sistemas modernos.</span>
    </h1>
    <p class="mt-6 max-w-xl text-lg text-ink-muted sm:text-xl">
      Soy <strong class="text-ink">{profile.name}</strong> — {profile.intro}
    </p>
    <div class="mt-9 flex flex-wrap gap-3.5">
      <a href={withBase('/proyectos')} class="btn btn-primary">Ver proyectos</a>
      <a href={withBase('/contacto')} class="btn btn-ghost">Contactar</a>
    </div>
    <div class="mt-9 flex flex-wrap items-center gap-3 text-sm text-ink-muted">
      <a href={profile.links.github} target="_blank" rel="noopener" class="text-ink hover:text-accent-cyan">GitHub</a>
      <span>·</span>
      <a href={profile.links.linkedin} target="_blank" rel="noopener" class="text-ink hover:text-accent-cyan">LinkedIn</a>
      <span>·</span>
      <span class="text-ink-faint">{profile.status}</span>
    </div>
  </div>

  <div class="relative hidden h-[420px] lg:block">
    <div class="card-surface absolute right-2 top-0 w-72 animate-floaty p-5">
      <div class="mb-2.5 flex items-center gap-2.5 font-bold"><span class="h-2.5 w-2.5 rounded-full bg-accent-cyan shadow-[0_0_12px_#22d3ee]"></span> FLK0S</div>
      <p class="text-sm text-ink-muted">Suite enterprise de ciberseguridad · Blue/Red Team · IA</p>
    </div>
    <div class="card-surface absolute left-0 top-[150px] w-72 animate-floaty p-5" style="animation-delay:.5s">
      <div class="mb-2.5 flex items-center gap-2.5 font-bold"><span class="h-2.5 w-2.5 rounded-full bg-accent-violet shadow-[0_0_12px_#a78bfa]"></span> FLAKAI</div>
      <p class="text-sm text-ink-muted">Análisis automático de fútbol desde vídeo con visión por computador</p>
    </div>
    <div class="card-surface absolute bottom-0 right-8 w-72 animate-floaty p-5 font-mono text-[13px]" style="animation-delay:1s">
      <div class="whitespace-nowrap"><span class="text-accent-violet">def</span> build(<span class="text-accent-cyan">future</span>):</div>
      <div class="whitespace-nowrap pl-6"><span class="text-accent-violet">return</span> ia + sistemas + seguridad</div>
    </div>
  </div>
</section>
